{
  "id": "41",
  "title": "女命贵格",
  "guide": "本篇讨论“女命贵格”相关旧法。阅读时先提取月令、日主、透藏、制化与岁运等条件，再与其他章节交叉核对，不直接套用结果性断语。",
  "blocks": [
    {
      "heading": "",
      "original": "正气官星。",
      "commentary": "",
      "id": "41-aa954761ec0f2f1727ca-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "财官两旺。",
      "commentary": "",
      "id": "41-e55535fa256badddca2c-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "印綬天德。",
      "commentary": "",
      "id": "41-29f9a3b7a4e5767c67b6-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "独杀有制。",
      "commentary": "",
      "id": "41-9700be77ff255b7e7d16-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "伤官生财。",
      "commentary": "",
      "id": "41-480be6d51b2aeaa14c76-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "坐禄逢财。",
      "commentary": "",
      "id": "41-5fbcdda98698ff0ac89e-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "官星带合。",
      "commentary": "",
      "id": "41-ba46a594769fb96ca39d-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "日贵逢财。",
      "commentary": "",
      "id": "41-d583edc495efb153dad8-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "官贵逢官。",
      "commentary": "",
      "id": "41-166468715e9cca319050-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "官星坐禄。",
      "commentary": "",
      "id": "41-b515953d11547635198a-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "官星桃花。",
      "commentary": "",
      "id": "41-f1672176b03e955c088e-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "食神生旺。",
      "commentary": "",
      "id": "41-00d123b5ecbede7950e3-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "食神生财。",
      "commentary": "",
      "id": "41-f50a4a450fa7fce9a9fb-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "杀化印綬。",
      "commentary": "",
      "id": "41-4a6c8572b3e11c3e60db-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "二德扶身。",
      "commentary": "",
      "id": "41-1d1247dd47a1bcb39ccc-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "三奇合局。",
      "commentary": "",
      "id": "41-6b3084377d4c01692c7b-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "阳刃有制。",
      "commentary": "",
      "id": "41-7d1dfa9f96af14798be0-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "拱禄拱贵。",
      "commentary": "",
      "id": "41-ed5753d7e970daf803e6-0",
      "translation": null
    },
    {
      "heading": "",
      "original": "归禄逢财。",
      "commentary": "",
      "id": "41-44cdcd0ea5de502b6d82-0",
      "translation": null
    }
  ],
