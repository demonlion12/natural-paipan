{
  "qiongtong:甲:0": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-35cbcee2c23421a7dfbb-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "正月甲木，初春尚有余寒，得丙癸逢，富贵双全。癸藏丙透，名寒木向阳，主大富贵。倘风水不及，亦不失儒林俊秀。如无丙癸，平常人也。"
  },
  "qiongtong:甲:1": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-dbf6b4abedf7069834ec-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "二月甲木，庚金得所，名阳刃驾杀，可云小贵，异途显达，或主武职，但要财资之。柱中逢才，英雄独压万人。若见癸水，困了才杀，主为光棍，重刃必定遭凶。性情凶暴。书曰：木旺宜火之光辉，秋闱可试。木向春生，处世安然有寿。日主无依，却喜运行才地。"
  },
  "qiongtong:甲:2": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-b423432bd44b752a7555-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月甲木，木气相竭。先取庚金，次用壬水。庚壬两透，一榜堪图。但要运用相生，风水阴德，方许富贵。"
  },
  "qiongtong:甲:3": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-471f80feef41ceb102de-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "四月甲木退气，丙火司权，先癸后丁。"
  },
  "qiongtong:甲:6": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-6116503043e86066ae57-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "七月甲木，丁火为尊，庚金次之，庚金不可少。火隔水不能镕金，故丁火镕金，必赖甲木引助，方成洪炉。若有癸水阻隔，便灭丁火，壬水无碍，且能合丁，但须见戊土，方可制水存火。"
  },
  "qiongtong:甲:7": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-5848a966cff585f18dd3-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "八月甲木，木囚金旺。丁火为先，次用丙火，庚金再次。"
  },
  "qiongtong:甲:8": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-a9fedffceeef251ee1b4-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "九月甲木，木星凋零，独爱丁火，壬癸滋扶，丁壬癸透，戊己亦透，此命配得中和，可许一榜。庚金得所，科甲定然。"
  },
  "qiongtong:甲:9": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-08a69d1e844cdafac5a7-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十月甲木，庚丁为要，丙火次之。忌壬水泛身，须戊土制之。"
  },
  "qiongtong:甲:10": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-a229e08873a15bd7529a-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十一月甲木，木性生寒，丁先庚后，丙火佐之。癸水司权，为火金之病。庚丁两透，支见巳寅，科甲有准，风水不及，选拔有之。若癸透伤丁。无戊己辅救，残疾之人。或壬水重出，丁火全无者，庸人也，得丙方妙。"
  },
  "qiongtong:甲:11": {
    "bookId": "qiongtong",
    "chapterId": "03",
    "chapterTitle": "论甲木",
    "passageId": "03-937bbcb4669e07a7c632-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十二月甲木，天寒气冻，木性极寒，无生发之象，先用庚噼甲，方引丁火始得木火有通明之象，故丁次之。"
  },
  "qiongtong:乙:0": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-be93491482b957bb704b-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "正月乙木，必须用丙，因天气尤有余寒，非丙不暖，虽有癸水，恐凝寒气，故以丙火为先，癸水次之。"
  },
  "qiongtong:乙:1": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-beb2e4b18da6a9631c07-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "二月乙木，阳气渐升，木不寒矣，以丙为君，癸为臣，丙癸两透，不透庚金，大富大贵。"
  },
  "qiongtong:乙:2": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-80297de01602d43dcad1-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月乙木，阳气愈炽，先癸后丙。"
  },
  "qiongtong:乙:3": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-0590162aae7e5fd2f2c7-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "四月乙木，自有丙火，耑取癸水为尊。四月乙木专用癸水，丙火酌用，虽以庚辛佐癸，须辛透为清。癸透、庚辛又透，科甲定然，独一点癸水、无金，是水无根，虽出天干，不过秀才小富，须要大运相扶。或土多困癸，贫贱之人。丙戊太多，支成火局，瞽目之流。"
  },
  "qiongtong:乙:4": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-ff1f8b0e5e3f89414d0a-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "五月乙木，丁火司权，禾稼俱旱。上半月属阳，仍用癸水。下半月属阴，三伏生寒，丙癸齐用。柱多金水，丙火为先，余皆用癸水为先。"
  },
  "qiongtong:乙:5": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-15c3ddb48276bfb5972e-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "六月乙木，木性且寒，柱多金水，丙火为尊。支成水局，乙得无伤。癸水透干，大富大贵。无癸定作常人，运不行北，困苦一生。"
  },
  "qiongtong:乙:6": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-c2afefe989f97d559ef8-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "七月乙木，庚金乘令，庚虽输情于乙妹，怎奈干乙难合支金。柱见庚多，乙难受载。或丙透干，又加巳出埋金，此格可云科甲。有己透、加丙，亦是上命。七月喜己土为用，或不见丙癸。己土必不可少，此则以火为妻，土为子。"
  },
  "qiongtong:乙:7": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-b01f85ff3a181050d456-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "八月乙木，芝兰禾稼均退。以丹桂为乙木。在白露之后，桂蕊未开，耑用癸水以滋桂萼。若秋分后，桂花已开，却喜向阳，又宜用丙，癸水次之，丙癸两透，科甲名臣。"
  },
  "qiongtong:乙:8": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-dff412fa6629bd8943a8-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "九月乙木，根枯叶落，必赖癸水滋养。如见甲申时，名为藤萝系甲，可秋可冬。若见癸水，又遇辛金发水之源，定主科甲。或有癸无辛，常人。有辛无癸，贫贱。或四柱壬多，水难生乙，亦是寻常之辈。"
  },
  "qiongtong:乙:9": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-89fc225e54bc28b65053-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十月乙木，木不受气，而壬水司令，取丙为用，戊土次之。丙戊两透，科甲定然。有丙无戊，虽不科甲，亦入儒林。支多丙火，运入火乡，亦主显达。"
  },
  "qiongtong:乙:10": {
    "bookId": "qiongtong",
    "chapterId": "04",
    "chapterTitle": "论乙木",
    "passageId": "04-ed6c70260bb2c6a00c41-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十一月乙木，花木寒冻，一阳来复，喜用丙火解冻，则花木有向阳之意，不宜用癸以冻花木，故耑用丙火。"
  },
  "qiongtong:丙:0": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-5829d40d759b99548a1a-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "正月用壬，庚辛为助。二月耑用壬水。三月土重晦光，取甲佐之为妙。"
  },
  "qiongtong:丙:1": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-8e28e606b87ae23c5a77-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "二月丙火，阳气舒升，耑用壬水。壬透天干，不见丁化，加以庚辛己亦透，壬水有根，定主科甲。"
  },
  "qiongtong:丙:2": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-50f75ce7d07866980999-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月丙火，气渐炎升，用壬水。或成土局，取甲为辅，壬不可离。壬甲两透，科甲定宜，惟忌庚出制甲，则秀才而已。无甲用庚，助壬水洩土气。"
  },
  "qiongtong:丙:3": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-b0cbf8e84ac69744e07d-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "四月耑用壬水，金为佐。五月亦耑用壬。四五月壬透者富贵。丁多、兼看癸水。六月用壬，但借庚金为佐。"
  },
  "qiongtong:丙:4": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-f58bdfcef069aa319138-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "五月丙火，得壬高透，方为上命。或一壬无庚，亦主贡监，犹防戊己出干，丁壬化合，则为平人。即不透庚壬，或有申宫长生之水，济之坐禄之金，至妙，必入词林。又怕戊己杂乱，则为异路。"
  },
  "qiongtong:丙:5": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-cca560d2ffa5d1b8a036-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "六月丙火退气，三伏生寒，壬水为用，取庚辅佐。"
  },
  "qiongtong:丙:6": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-cb20125fcec28c3105aa-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "七月丙火，太阳转西，阳气衰矣。日近西山，见土皆晦，惟日照湖海，暮夜光天，故仍用壬水，辅映光辉。"
  },
  "qiongtong:丙:7": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-794e468da342748302ed-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "八月丙火，日近黄昏，丙火之余光，存于光湖，仍用壬水辅映。"
  },
  "qiongtong:丙:8": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-648843ced272c3b93019-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "九月丙火，火气愈退，所忌土晦光火，必须先用甲木，次取壬水。甲壬两透，富贵非凡。若无壬水，得癸透干，亦可，虽不科甲，异路功名。壬癸藏支，贡监而已。甲藏壬透，无庚破甲，可许秀才。或庚戊困了水木，定是庸才。无甲壬癸者，下格。"
  },
  "qiongtong:丙:9": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-0fd1c0d46f6ac39b8125-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十月丙火，太阳失令，得见甲戊庚出干，可云科甲，主为人性好清高，斯文领袖。如辛透见辰，名化合逢时，主大贵。"
  },
  "qiongtong:丙:10": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-832ede274937b180b58a-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十一月丙火，冬至一阳生，弱中复强，壬水为最，戊土佐之。"
  },
  "qiongtong:丙:11": {
    "bookId": "qiongtong",
    "chapterId": "06",
    "chapterTitle": "论丙火",
    "passageId": "06-8c679f93c38559581c9e-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十二月丙火，气进二阳，侮雪欺霜，喜壬为用。己土司令，土多又不可少甲。壬甲两透，科甲堪宜，甲藏则秀才而已。或无甲得一壬透，富中取贵。"
  },
  "qiongtong:丁:0": {
    "bookId": "qiongtong",
    "chapterId": "07",
    "chapterTitle": "论丁火",
    "passageId": "07-b3087032d72213ad45e3-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "正月丁火，甲木当权，乃为母旺，非庚不能噼甲，何以引丁，姑用庚金。"
  },
  "qiongtong:丁:1": {
    "bookId": "qiongtong",
    "chapterId": "07",
    "chapterTitle": "论丁火",
    "passageId": "07-5dba87bd442a85dbef88-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "二月丁火，溼乙伤丁，先庚后甲，非庚不能去乙，非甲不能引丁。庚甲两透，科甲定然。庚透甲藏，亦有生贡。甲透庚藏，异路功名。"
  },
  "qiongtong:丁:2": {
    "bookId": "qiongtong",
    "chapterId": "07",
    "chapterTitle": "论丁火",
    "passageId": "07-5b1b3055d46a85121754-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月丁火，戊土司令，洩弱丁气，先用甲木引丁制土，次看庚金。庚甲两透，定主科甲。或一藏一透，终非白丁。"
  },
  "qiongtong:丁:3": {
    "bookId": "qiongtong",
    "chapterId": "07",
    "chapterTitle": "论丁火",
    "passageId": "07-a1591d419f8c4745ca32-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "四月丁火乘旺，虽取甲引丁，必用庚噼甲。伐甲、方云木火通明。甲多、又取庚为先。但四柱忌见癸水。癸水一见，洩金、溼甲、伤丁，故以癸为病。或癸水藏支，壬水出干制丙，不夺丁光，自是雁塔题名，玉堂清贵。"
  },
  "qiongtong:丁:4": {
    "bookId": "qiongtong",
    "chapterId": "07",
    "chapterTitle": "论丁火",
    "passageId": "07-4fa0a8b9941b61234d4c-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "五月丁火，时归建禄，不宜乱用甲木。"
  },
  "qiongtong:丁:5": {
    "bookId": "qiongtong",
    "chapterId": "07",
    "chapterTitle": "论丁火",
    "passageId": "07-9c65091a34b12e7ac100-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "六月之丁，阴柔退气，但值三伏生寒，丁弱极矣，专取甲木，壬水次之。"
  },
  "qiongtong:丁:6": {
    "bookId": "qiongtong",
    "chapterId": "07",
    "chapterTitle": "论丁火",
    "passageId": "07-4cbd20bea6c187c42dbf-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "七月丁火，退气柔弱，端用甲木，金虽乘旺司权，无伤丁之理，仍取庚劈甲，为引火之物，或借丙暖金晒甲，不虑丙夺丁光，凡两丙夹丁者，夏月忌之，余月不忌，但此格少年困苦刑克中年富贵，必要地支见水制丙，方妙。"
  },
  "qiongtong:丁:10": {
    "bookId": "qiongtong",
    "chapterId": "07",
    "chapterTitle": "论丁火",
    "passageId": "07-557c30f4649834ae97ed-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十一月丁火，或仲冬水多癸旺，全无比印，此作弃命从杀，亦有异途功名。见丁比出干，难合格局，常人，且主骨肉浮云，六亲流水。戊出破癸，颇有兄弟妻儿。此格用戊，火妻土子。用甲、水妻木子。"
  },
  "qiongtong:戊:2": {
    "bookId": "qiongtong",
    "chapterId": "09",
    "chapterTitle": "论戊土",
    "passageId": "09-071d8ecdd0ae6949851c-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月戊土司令，不见丙甲癸者，愚而且贱。甲癸透者，科甲。丙癸透者、生员。甲癸俱藏者，只可云富，有癸异途。"
  },
  "qiongtong:戊:3": {
    "bookId": "qiongtong",
    "chapterId": "09",
    "chapterTitle": "论戊土",
    "passageId": "09-1e371b701f16e58e5022-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "四月戊土，阳气发升，寒气内藏，外实内虚，不畏火炎，无阳气相催，万物不长，故先用甲疏噼，次取丙癸为佐。"
  },
  "qiongtong:戊:4": {
    "bookId": "qiongtong",
    "chapterId": "09",
    "chapterTitle": "论戊土",
    "passageId": "09-3dc6050d1d910efa8761-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "五月戊土，仲夏火炎，先看壬水，次取甲木，丙火酌用，用癸力微。"
  },
  "qiongtong:戊:5": {
    "bookId": "qiongtong",
    "chapterId": "09",
    "chapterTitle": "论戊土",
    "passageId": "09-8560d6f50ed2b3a449eb-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "六月戊土，遇夏干枯，先看癸水，次用丙火甲木。癸丙两透，科甲中人。或有癸无丙，见甲可许秀才。无甲略富。或有丙无癸，假道斯文，衣食颇足。"
  },
  "qiongtong:戊:6": {
    "bookId": "qiongtong",
    "chapterId": "09",
    "chapterTitle": "论戊土",
    "passageId": "09-c96ee12f4f1dd717a400-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "七月戊土，阳气渐入，寒气渐出，先丙后癸，甲木次之。丙癸甲透者，富贵极品。癸藏丙透，不仅秀才。丙甲两透，癸水会局藏辰，亦不失富贵。无丙得癸甲透，此人清雅，家富千金。无癸甲者、常人。有丙火、妻贤子肖。若丙甲癸三者俱无，下流之命。"
  },
  "qiongtong:戊:7": {
    "bookId": "qiongtong",
    "chapterId": "09",
    "chapterTitle": "论戊土",
    "passageId": "09-ce16d11106863b9c49eb-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "八月戊土，金洩身寒，赖丙照暖，喜水滋润，先丙后癸，不必木疏。丙癸两透，科甲中人。丙透癸藏，可许入泮。癸透丙藏，纳资得官。若丙藏又无癸，即多不透，此皆常人。丙癸全无，奔流之客。"
  },
  "qiongtong:戊:8": {
    "bookId": "qiongtong",
    "chapterId": "09",
    "chapterTitle": "论戊土",
    "passageId": "09-5bce8f46347f43937c18-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "九月戊土当权，不可专用丙，先看甲木，次取癸水，却忌化合。见金先用癸水，后取丙火，配合支干，方成有生之土，定发云程。"
  },
  "qiongtong:戊:9": {
    "bookId": "qiongtong",
    "chapterId": "09",
    "chapterTitle": "论戊土",
    "passageId": "09-7c488e6214ed9ad0bc1a-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十月戊土，时值小阳，阳气略出，先用甲木，次取丙火。非甲、土不灵。非丙、土不暖，安能生发万物。甲丙两出，富贵中人。或甲得长生，遇支藏得地之水，一丙高透，亦主身贵扬名。"
  },
  "qiongtong:己:0": {
    "bookId": "qiongtong",
    "chapterId": "10",
    "chapterTitle": "论己土",
    "passageId": "10-9353583bf1073bf986d3-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "正月己土，田园犹冻，盖因腊气未除，余寒未退，故丙为尊。得丙照暖，万物自生，忌见壬水，反为己病，何也？壬乃江湖之水，湖水一发，则田园洗荡，变为沙土，而根苗尽没矣。须戊作堤，以保园圃。壬多要见戊制。有戊出干者，定主玉堂金马。若乏戊制，必属平常。"
  },
  "qiongtong:己:1": {
    "bookId": "qiongtong",
    "chapterId": "10",
    "chapterTitle": "论己土",
    "passageId": "10-fac7ffa631e9d02a9ffb-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "二月己土，阳气渐升，虽禾稼未成，万物出土，田园未展，先取甲木疏之，忌合。次取癸水润之。甲癸出干，定主科甲，加以一丙出透，势压百僚。一见壬水，微末官职。"
  },
  "qiongtong:己:2": {
    "bookId": "qiongtong",
    "chapterId": "10",
    "chapterTitle": "论己土",
    "passageId": "10-d757a14271ca45a37b1d-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月己土，正栽培禾稼之时，先丙后癸，土暖而润，随用甲疏，三者俱透天干，必官居黄阁。或三者透一，科甲定然，但要得地。却以庚金为病。"
  },
  "qiongtong:己:7": {
    "bookId": "qiongtong",
    "chapterId": "10",
    "chapterTitle": "论己土",
    "passageId": "10-d18a83b885da5507dc75-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "八月支成金局，无丙丁出救，此人零丁孤苦。如得丙透丁藏，生己元神，此人名魁天下，五福完人。"
  },
  "qiongtong:庚:0": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-e5beaab85049895f65b8-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "正月庚金，木旺之际，有土皆死，不能生金，且金之寒气未除，先用丙暖庚性，又虑土厚埋金，须甲疏洩。丙甲两透，科甲显荣。二者透一，亦有生监。丙藏甲透，异路功名。"
  },
  "qiongtong:庚:1": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-902158e6699b2ab12ee4-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "二月庚金，柱中自然有乙，当令之乙，见庚必输情于乙，此金有暗强之势，如秋金一理，故二月庚金，专用丁火，借甲引丁，借庚噼甲。无丁用丙者，富贵多出于勉强。"
  },
  "qiongtong:庚:2": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-1713ec1dcf79e347d5c5-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月庚金，戊土司令，无生金之理，有埋金之忧，故先甲后丁，不用庚噼甲。三月之庚，土旺金顽，顽金宜丁，旺土须甲，乏甲不能立业，乏丁焉能成名。二者少一，富贵不真。"
  },
  "qiongtong:庚:3": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-b937dd11a06dff81e534-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "四月庚金，长生于巳，巳内有戊。丙不镕金，故不畏火炎，丙亦可作用，但先壬水，方得中和，故曰群金生夏，喜用勾陈。次取戊土，丙火佐之。三者皆全，登科及第，即透一二，亦非白丁。"
  },
  "qiongtong:庚:4": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-2e7103e72b78b815677c-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "五月庚金，丁火旺烈，庚金败地，专用壬水，癸又次之。壬透癸藏，支见庚辛，必然科甲，切忌戊己透干制水、则否。戊藏支内，不失儒林。或壬在支，有金生助，又得金神出干，明经之贵。或癸出带辛，异路之荣。"
  },
  "qiongtong:庚:5": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-a4cfb3b93eff97987ad3-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "六月庚金，三伏生寒，顽钝极矣，先用丁火，次取甲木。丁甲两透名显身荣，忌癸伤丁。有甲无丁、庸俗。有丁无甲、生员。丁甲全无，下贱之人。木虽有，丁不透，支又见水，执鞭之士。丁火无伤，贸易之流。"
  },
  "qiongtong:庚:6": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-c8fe3d428e2ee14520bb-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "七月庚金，刚锐极矣。专用丁火煅炼，次取甲木引丁，故曰：秋金锐锐最为奇，壬癸相逢总不宜，如逢木火来成局，试看福寿与天齐。"
  },
  "qiongtong:庚:7": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-2dc0003cce9e89d5bd48-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "八月庚金，刚锐未退，用丁用甲，丙不可少。若丁甲透，又见一丙，功名显赫，且见羊刃，无刑剋，丙杀藏支，名为羊刃驾杀，主出将入相，直介忠臣。"
  },
  "qiongtong:庚:8": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-20708a44c46c2572ccbf-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "九月庚金，戊土司令，最怕土厚埋金，宜先用甲疏，后用壬洗，则金自出矣。忌见己土浊壬。"
  },
  "qiongtong:庚:9": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-7ad352e1bb2101f25580-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十月庚金，水冷性寒，非丁莫造，非丙不暖。丁甲两透，支无水局，一榜有之。支藏丙火，桃浪之仙。支见亥子，得己出制，亦有功名。"
  },
  "qiongtong:庚:10": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-e7f1f163a7245b4d382e-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十一月庚金，天气严寒，仍取丁甲，次取丙火照暖。或丁甲两透，丙在支中，必主科甲。即无丙火，亦有衣衿。有丁无甲，亦可富中取贵。有甲无丁，只作常人。或丙透丁藏，异途名望。丁藏有甲，武学可许。"
  },
  "qiongtong:庚:11": {
    "bookId": "qiongtong",
    "chapterId": "11",
    "chapterTitle": "论庚金",
    "passageId": "11-de0e7bf0dcd1dacdf8ea-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十二月庚金，寒气太重，且多湿泥，愈寒愈冻，先取丙火解冻，次取丁火炼金，甲亦不可少。"
  },
  "qiongtong:辛:0": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-6d0a56a263b2dc6e3f78-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "正月辛金，阳气舒而寒气未除，不知正月建寅，中有长生之丙，解去寒气，忌甲木司权，辛金失令，取己土为生身之本，欲得辛金发现，全赖壬水之功，己壬两透，支见庚制甲，科甲定然。或己土透干，支中有甲，异路恩荣。或己土不全，号曰君臣失势，富贵难全。或有丙火出干，亦主武学。或见壬、无己庚者，贫贱之徒。"
  },
  "qiongtong:辛:1": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-4feff803f381c4c754fc-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "二月辛金，阳和之际，壬水为尊，见戊己为病。得甲制伏，则辛金不致埋没，壬水不致混浊，合此者必身入玉堂。故二月辛金，有壬甲透者贵显。否则，乡绅。或壬坐亥支，不见土出，可能入芥，家亦小康。得申中之壬者，异途名望。无壬者常人。其生剋之理，与正月辛金皆同。"
  },
  "qiongtong:辛:2": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-aff1dddd088b1cf75c50-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月辛金，戊土司令，辛承正气，母旺子相，先壬后甲。壬甲两透，富贵必然。壬透甲藏，廪贡不失。甲透壬藏，富则可云。壬甲皆无，平常之格。"
  },
  "qiongtong:辛:3": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-abf8b1f63e8e3b8fcae5-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "四月辛金，时逢首夏，忌丙火之燥烈，喜壬水之洗淘。支成金局，水透出干，有木制戊，名一清澈底，科甲功名。癸透壬藏，富真贵假。若壬癸皆藏，戊己亦藏，略富。若壬癸俱无，反见火出，必主鳏独。"
  },
  "qiongtong:辛:4": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-36da2cdc688b2243efa4-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "五月辛金，丁火司权，辛金失令，阴柔之极，不宜煅炼，须己壬兼用，何也？己为泥沙，壬为湖海，己无壬不湿，辛无己不生，故壬己并用。无壬、癸亦可用。但癸力小。或支成火局，即重见癸出亦不济，得壬透破火方可，必主生员。若无壬，癸见戊，虽有午宫己土，燥泥成灰，金必毁镕，反遭埋没，必为僧道。有一二重比肩，不致孤独。"
  },
  "qiongtong:辛:5": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-484dbcf5e15bb6fbd5b9-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "六月辛金，己土当权，辅助太多，恐掩金光，先用壬水，取庚佐之。壬庚两透，科甲功名，即不出干，藏支得所，亦有荣华。但忌戊出，得甲制之，方吉。甲须隔位，恐贪己合，反掩金光，又塞壬水之流，下贱之格。又忌庚出制甲。或只有未中一己，见了壬水，又为湿泥。不可见甲，甲出，反作平人。总以一壬一己，见庚无甲，方妙﹐与五月用己壬同。"
  },
  "qiongtong:辛:6": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-bda69e207b94a5f00e96-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "七月辛金，值庚司令，不旺自旺，且壬水居申，四柱不见戊土，胎元戊藏申内，为壬堤岸，人命得此，为官清正，但不富耳。"
  },
  "qiongtong:辛:7": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-c646ab7cfc988cc4bcd0-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "八月辛金，当权得令，旺之极矣，专用壬水淘洗火，故云：金见水以流通。如见戊己，则生扶太过，故以土为病，见甲制土、方妙。无戊、不宜用甲。"
  },
  "qiongtong:辛:8": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-76439aa4fafa3ef6c271-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "九月辛金，戊土司令，母旺子相，须甲疏土，壬洩旺金，先壬后甲。壬甲两透，桃洞之仙。或壬透甲藏，又见戊者，平人。甲透、壬藏，戊在支内，异途之仕。"
  },
  "qiongtong:辛:9": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-fc88e6cf05581ae82cdc-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十月辛金，时值小阳，阳气渐升，寒气将降，先用壬水，次取丙火，壬丙两透，金榜题名，何也？盖辛金有壬水丙火，名金白水清，又在亥月故发。丙透壬藏，采芹之造。丙藏壬透，富有千金。壬丙在支，聪明之士。"
  },
  "qiongtong:辛:10": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-ecac063544467b746ba1-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十一月辛金，癸水司令，为寒冬雨露，切忌癸出冻金，而困丙火，壬丙两透，不见戊癸，衣锦腰金。即壬藏丙透，一榜堪图。"
  },
  "qiongtong:辛:11": {
    "bookId": "qiongtong",
    "chapterId": "12",
    "chapterTitle": "论辛金",
    "passageId": "12-69e7cfb0095045d1a953-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十二月辛金，寒冻之极，先丙后壬，无丙不能解冻，无壬不能洗淘。丙壬两透，金马玉堂之客。壬丙俱藏，游庠食饩之人。有丙无壬富真贵假。有壬乏丙，贱而且贫。或丙多、无壬、有癸，市中贸易之流。"
  },
  "qiongtong:壬:0": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-0dff129110216379fcb7-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "正月壬水，汪洋之象，能并百川之流，然水性柔弱，宜用庚金之源，庶不致汪洋无度。有庚丙戊三者齐透，科甲功名。或庚戊藏支，丙坐寅支者，亦有恩诰，即一庚透，贡监有之。"
  },
  "qiongtong:壬:1": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-0e3fe9c22dd5076f0a21-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "二月壬水，寒气初除，有并流之象，不用丙暖，专取戊土辛金。二月壬水，先戊后辛，庚金次之。"
  },
  "qiongtong:壬:2": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-9abe77a5a1e332f0aeb6-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月壬水，戊土司权，恐有推山填海之患，先用甲疏季土，次取庚金。甲庚俱透，科甲定然。甲透庚藏，修齐品格。甲藏有根，可云俊秀。有癸滋甲，必主干城。独甲藏支，必富。独庚在柱，常人。无甲、刚暴之徒。乏庚、愚顽之辈。"
  },
  "qiongtong:壬:3": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-f4ce58c4c29253f6a4a2-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "四月壬水，丙火司权，水弱极矣，专取壬水比肩为助，次取辛金发源，且暗合丙火，庚金为佐。壬辛两透，金榜有名，或癸辛两出，加以甲透，亦主异路之荣。无甲者、富贵门下之客。"
  },
  "qiongtong:壬:4": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-d7f074598414bb2067c5-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "五月壬水，丁旺壬弱，取癸为用，取庚为佐。无庚不能发水，无癸不能伤丁。五月壬水，辛癸亦可参用，其理与四月皆同。"
  },
  "qiongtong:壬:5": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-d026198640e67462653e-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "六月壬水，己土当权，丁火退气，先用辛金癸水，次用甲木噼土。六月壬水，先辛后甲，次取癸水。辛甲两透，富贵清高。甲藏辛透，贡监生员。辛藏甲透，异途武职。甲壬两透，无伤，有治国之贵。即甲藏壬出无破，是拾芥之才。或支多土火，又只清贫。"
  },
  "qiongtong:壬:6": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-65c748ac3a26ac5ae2a0-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "七月壬水，庚金司令，壬得申之长生，源流自远，转弱为强，专用戊土，次取丁火佐戊制庚。但用辰戌之戊，不用申中受病之戊。戊丁俱透，科甲生员。戊透天干，丁藏午戌，恩封可待，特忌戊癸化合。即支见寅戌，年出丁火，可许衣衿。或丁戊两藏，富中取贵。"
  },
  "qiongtong:壬:7": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-7a112de0189deedd93a8-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "八月壬水，辛金司权，正金白水清，忌戊土为病，专用甲木。甲木一透制戊，壬水澈底澄清，名高翰苑。若甲出时干，功名显达，设见庚破，又属常人。即甲藏支、无庚，秀才可许。"
  },
  "qiongtong:壬:8": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-747e8a30644613637d1f-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "九月壬水进气，其性特厚，若一派壬水，见一甲、制戌中之戊，戊又出干，斯用丙火。此格清贵极矣，正合一将当关，群邪自伏，或不见丙戊，亦不为妙。"
  },
  "qiongtong:壬:9": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-6438db7e72efad0bc23b-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十月壬水司权，至旺之极，取戊为用，若生辰日干，又见辰时，必须戊透，又须庚制甲，不伤戊土，戊庚两全，定主豋科乃第，位显权高。或甲出制戊，不见庚救者，断之贫穷。戊藏无制，可许生员。或戊庚两透无甲者，亦主荣显。"
  },
  "qiongtong:壬:10": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-7558d675a5a6f32dc8cc-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十一月壬水，阳刃帮身，较前更旺，先取戊土，次用丙火，丙戊两透，富贵荣华。有戊无丙，略可言富。有丙无戊，好谋无成。"
  },
  "qiongtong:壬:11": {
    "bookId": "qiongtong",
    "chapterId": "14",
    "chapterTitle": "论壬水",
    "passageId": "14-b97d7b03c1dada1721b0-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十二月壬水，旺极复衰，何也？上半月癸辛主事，故旺，专用丙火。下半月己土主事，故衰。亦用丙火，甲木佐之。"
  },
  "qiongtong:癸:0": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-56bb9cc9f99a7de961a2-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "正月癸水，值三阳之候，雨露之精，其性至柔，先用辛金，生癸水之源，次用丙火照暖，名阴阳和合，万物发生。辛丙两透，金榜有名。"
  },
  "qiongtong:癸:1": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-6bd5835aca45cd720a0a-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "二月癸水，不刚不柔，乙木司令，洩弱元神，专以庚金为用，辛金次之。庚辛俱透，无丁出干者，贵由科甲。无庚辛者常人。或庚透辛藏，荣封有准。庚藏辛透，亦有衣衿。庚辛两藏，富中取贵，或刀笔扬名。或庚辛重见，有己丁出干者亦贵。"
  },
  "qiongtong:癸:2": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-9b024588567ad47c9626-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "三月癸水，要分清明谷雨。清明后、火气未炽，专用丙火，为阴阳合谐。谷雨后，虽用丙火，尚宜辛甲佐之。如辛卯、壬辰、癸未、丙辰，生上半月，用丙火、显达。生下半月，必无伤辛金癸水、方妙。然丙亦不可少。用丙、木妻、火子。"
  },
  "qiongtong:癸:3": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-8e5653742f6dd2666e4b-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "四月癸水，喜辛金为用，无辛用庚。若辛高透，不见丁火，加以壬透，主科名荣贵，声播四夷。若有丁破格，贫无立锥，有壬可免。辛藏无丁，贡监衣衿。"
  },
  "qiongtong:癸:4": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-3ffbd7b139dc6cb4ee5e-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "五月癸水，至弱无根，必须庚辛为生身之本，但丁火司权，金难敌火，安能滋养癸水，宜见比劫，方得辛金之用。五月癸水，庚辛壬参酌并用可也。"
  },
  "qiongtong:癸:5": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-39d67d69c9b4e12a2eca-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "六月癸水，有上下月之分。下半月庚辛有气，上半月庚辛休囚。凡六癸日、多不验者，何也？俗士不知此理。因未中有乙己同宫，破而不破，故癸水不能从杀，所以专用庚辛。如上半月金神衰弱，火气炎烈，宜比劫助身，可云富贵。与五月一理。下半月庚辛有气，即无比劫亦可，又忌丁透，即丁在支亦不吉。其生剋制化，与五月略同。"
  },
  "qiongtong:癸:6": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-e68579062822770b796a-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "七月癸水，正母旺子相之时，癸虽死申，殊不知申中有庚生之，名死处逢生，弱中复强，即运行西北，亦不死也。但庚司令刚锐极矣，必取丁火为用。或丁透有甲，名有燄之火，必主科甲。或丁透无甲，又无壬癸，即有一二庚金，亦有生监。有二丁更妙。或金多乏丁制者，贫困之人。"
  },
  "qiongtong:癸:7": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-32d51c4c4e46e58baba1-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "八月癸水，辛金虚灵，非顽金可比，正金白水清，故取辛金为用，丙火佐之。名水暖金温。如丙与辛隔位同透，主科甲功名。或丙透辛藏，一榜之士。或土多水，生意中人。"
  },
  "qiongtong:癸:8": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-155ae2587542b1491eca-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "九月癸水，失令无根，戊土司权，剋制太过，专用辛金发水之源，要比肩滋甲制戊方妙。或辛甲两透，支见子癸，定主平步青云，或癸甲两透，富贵成名。或有甲辛无癸者，亦有恩封。或有甲癸无辛者，富大贵小。有甲无癸辛者，常人。二者俱无，贫贱之格。或有甲见壬者，颇许衣衿。"
  },
  "qiongtong:癸:9": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-fd7e3371a6ee508e2421-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十月癸水，旺中有弱，何也？因亥摇木，洩散元神，宜用庚辛为妙。得庚辛两透，不见丁伤者，功名有准。"
  },
  "qiongtong:癸:10": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-bf34d69972e2582c6171-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十一月癸水，值冰冻之时，金水无交欢之象，专用丙火解冻，庶不致成冰，又要辛金滋扶，无丙有辛，不妙。凡冬季癸水，有丙透解冻，则金温水暖，两两相生，要不见壬癸，自然豋科及第，紫诰金章。"
  },
  "qiongtong:癸:11": {
    "bookId": "qiongtong",
    "chapterId": "15",
    "chapterTitle": "论癸水",
    "passageId": "15-259538ac436de61c9df7-0",
    "version": "364fb88edf5749484d21",
    "sourceUrl": "https://zh.wikisource.org/wiki/穷通宝鉴",
    "text": "十二月癸水，寒极成冰，万物不能舒泰，宜丙火解冻。或丙透年时，加以壬透，支中多戊，名水辅阳光，主显达名臣，无戊者，异途之职。若有丙无壬，黉门之客。有壬无丙，戊又出干者，皂隶之流。"
  },
  "ditiansui": {
    "bookId": "ditiansui",
    "chapterId": "16",
    "chapterTitle": "寒暖論",
    "passageId": "16-3904f1a40f7da6b30092-0",
    "version": "a905177ef747339b21cf",
    "sourceUrl": "https://zh.wikisource.org/wiki/滴天髓",
    "text": "天道有寒暖，發育萬物，人道得之，不可過也。"
  }
}
